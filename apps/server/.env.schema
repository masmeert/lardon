# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=61ecdfdb-691e-4e12-8852-f0911a66c04d,
#   environment=remap($APP_ENV, development, dev, staging, staging, production, prod),
#   siteUrl="https://eu.infisical.com",
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Which Infisical environment to read secrets from. Separate from NODE_ENV because Alchemy forces
# NODE_ENV=production for every command, `alchemy dev` included. Deploys set APP_ENV=production or staging.
# @public @type=enum(development, staging, production)
APP_ENV=development

# Machine identity (Universal Auth) that reads this project's secrets from Infisical.
# Keep both in a gitignored .env.local or the deploy environment, never in the repo.
# @type=infisicalClientId @required=false
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret @internal @required=false
INFISICAL_CLIENT_SECRET=

# @type=string(minLength=32)
BETTER_AUTH_SECRET=infisical()

# @type=url
BETTER_AUTH_URL=infisical()

# @type=url
CORS_ORIGIN=infisical()

# OAuth client for "Continue with Google". Leave empty to turn Google sign-in off.
# Create a "Web application" client in Google Cloud with redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
# @sensitive=false @required=false
GOOGLE_CLIENT_ID=infisical()

# @required=false
GOOGLE_CLIENT_SECRET=infisical()

# iOS bundle identifier with the "Sign in with Apple" capability. Set it empty to turn Apple sign-in off.
# @sensitive=false @required=false
APPLE_BUNDLE_ID=com.masmeert.lardon

# Sender of account emails. The domain must be onboarded to Cloudflare Email Sending.
# @sensitive=false
EMAIL_FROM="Lardon <noreply@lardon.masmeert.org>"
