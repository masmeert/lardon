# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# OAuth client for "Continue with Google". Leave empty to turn Google sign-in off.
# Create a "Web application" client in Google Cloud with redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
# @sensitive=false @required=false
GOOGLE_CLIENT_ID=

# @required=false
GOOGLE_CLIENT_SECRET=

# iOS bundle identifier with the "Sign in with Apple" capability. Set it empty to turn Apple sign-in off.
# @sensitive=false @required=false
APPLE_BUNDLE_ID=com.masmeert.lardon

# Sender of account emails, e.g. "Lardon <hello@example.com>". The domain must be onboarded to Cloudflare Email.
# @sensitive=false
EMAIL_FROM=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=
