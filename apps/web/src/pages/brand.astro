---
import Logo from "@lardon/brand/assets/logo.svg";
import LogoStacked from "@lardon/brand/assets/logo-stacked.svg";
import Mark from "@lardon/brand/assets/mark.svg";
import Wordmark from "@lardon/brand/assets/wordmark.svg";
import { colors } from "@lardon/brand";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import Base from "../layouts/base.astro";
---

<Base title="Brand" description="The Lardon logo, colors, type and the rules we design by.">
  <div class="bg-accent text-white">
    <SiteHeader class="max-w-5xl" surface="accent" />
    <div class="mx-auto max-w-5xl px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
      <h1 class="text-[34px] leading-[41px] font-bold tracking-tight">Brand</h1>
      <p class="mt-4 text-[17px] text-white/80">Our logo, colors, type and the rules we design by.</p>
      <a
        href="/brand/lardon-brand-assets.zip"
        download
        class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full bg-paper px-5 text-sm font-semibold text-foreground hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-card"
      >
        Download all files
        <span class="font-normal text-muted">ZIP, 0.6 MB</span>
      </a>
    </div>
  </div>
  <main class="mx-auto max-w-5xl px-6 pt-4 pb-24">
    <section class="mt-20" aria-labelledby="logo">
      <h2 id="logo" class="text-2xl font-medium text-foreground">Logo</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          [
            "bg-paper ring-1 ring-hairline ring-inset text-foreground",
            "bg-accent text-bacon",
            "bg-foreground text-background",
          ].map((tile) => (
            <div class:list={["flex h-40 items-center justify-center rounded-[18px] px-8", tile]}>
              <Logo class="h-9 w-auto max-w-full" />
            </div>
          ))
        }
        <div
          class="flex h-40 items-center justify-center rounded-[18px] bg-paper text-foreground ring-1 ring-hairline ring-inset"
        >
          <LogoStacked class="h-24 w-auto" />
        </div>
        <div
          class="flex h-40 items-center justify-center rounded-[18px] bg-paper text-accent ring-1 ring-hairline ring-inset"
        >
          <Mark class="h-20 w-auto" />
        </div>
        <div class="flex h-40 items-center justify-center rounded-[18px] bg-fill">
          <img
            src="/brand/lardon-app-icon-rounded.svg"
            alt=""
            width="96"
            height="96"
            class="size-24 drop-shadow-[0_1px_2px_rgb(34_28_24/0.12)]"
          />
        </div>
      </div>
      <p class="mt-4 max-w-xl text-sm leading-relaxed">
        Use the full logo when it fits and the bacon strip when it doesn't. Keep it at least 20 px
        tall, with room around it.
      </p>
    </section>

    <section class="mt-20" aria-labelledby="principles">
      <h2 id="principles" class="text-2xl font-medium text-foreground">Principles</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          [
            ["Calm", "Small type, wide margins, few colors. The recipe photos bring the color."],
            ["One accent", "Olive is for the main action, selection and focus. One olive button per screen."],
            ["Flat", "No gradients, glows or heavy shadows. The food photos are the only thing that floats."],
            ["Native first", "Headers, sheets, menus and controls come from the system. We style what's inside them."],
          ].map(([title, text]) => (
            <div class="rounded-[18px] bg-paper p-5">
              <p class="text-base font-semibold text-foreground">{title}</p>
              <p class="mt-1 text-sm leading-relaxed">{text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-20" aria-labelledby="color">
      <h2 id="color" class="text-2xl font-medium text-foreground">Colors</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed">
        The system's greys and one olive. All text on these colors meets WCAG AA contrast.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          [
            ["Page", "Behind everything", colors.background, "bg-background ring-1 ring-hairline ring-inset", "text-foreground"],
            ["Paper", "Cards and fields", colors.paper, "bg-paper", "text-foreground"],
            ["Fill", "Tiles and dividers", colors.fill, "bg-fill", "text-foreground"],
            ["Secondary", "Secondary text", colors.muted, "bg-muted", "text-white"],
            ["Text", "Text", colors.foreground, "bg-foreground", "text-white"],
            ["Olive", "Main action", colors.accent, "bg-accent", "text-white"],
            ["Bacon", "The logo on olive", colors.bacon, "bg-bacon ring-1 ring-hairline ring-inset", "text-foreground"],
            ["Paprika", "Errors", colors.danger, "bg-danger", "text-white"],
          ].map(([name, role, hex, swatch, ink]) => (
            <div class:list={["flex h-32 flex-col justify-between rounded-[18px] p-4", swatch, ink]}>
              <span class="font-mono text-xs">{hex.toUpperCase()}</span>
              <span>
                <span class="block text-sm font-semibold">{name}</span>
                <span class="block text-xs">{role}</span>
              </span>
            </div>
          ))
        }
      </div>
      <h3 class="mt-10 text-base font-semibold text-foreground">Supporting</h3>
      <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-4 sm:grid-cols-4">
        {
          [
            ["Olive tint", "Selected backgrounds", colors.accentSoft],
            ["Deep olive", "Pressed olive", colors.accentDeep],
            ["Paprika tint", "Error backgrounds", colors.dangerSoft],
            ["Sage", "Photos while they load", colors.placeholder],
          ].map(([name, role, hex]) => (
            <li class="flex items-center gap-3">
              <span
                class="size-10 shrink-0 rounded-full ring-1 ring-hairline ring-inset"
                style={`background-color: ${hex}`}
              />
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-foreground">{name}</span>
                <span class="block text-xs">{role}</span>
                <span class="block font-mono text-xs">{hex.toUpperCase()}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="type">
      <h2 id="type" class="text-2xl font-medium text-foreground">Type</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed">
        Six sizes of Inter, each with its own line height. Hierarchy comes from size and
        weight, not capitals or letter-spacing.
      </p>
      <ul class="mt-6 divide-y divide-hairline border-y border-hairline">
        {
          [
            ["Display", "38/44, bold", "8 recipes", "text-[38px] leading-[44px] font-bold"],
            ["Headline", "22/28, semibold", "What's your email?", "text-[22px] leading-[28px] font-semibold"],
            ["Title", "17/22, semibold", "Sunday dinners", "text-[17px] leading-[22px] font-semibold"],
            ["Body", "16/21, regular", "Pâtes à la moutarde", "text-[16px] leading-[21px]"],
            ["Caption", "14/18, regular", "4 people, 35 min", "text-[14px] leading-[18px]"],
            ["Label", "13/16, semibold", "Under 30 min", "text-[13px] leading-[16px] font-semibold"],
          ].map(([role, size, sample, style]) => (
            <li class="grid grid-cols-[8rem_1fr] items-center gap-4 py-4">
              <span>
                <span class="block text-sm font-semibold text-foreground">{role}</span>
                <span class="block text-xs">{size}</span>
              </span>
              <span class:list={["text-foreground", style]}>{sample}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-[18px] bg-paper p-5">
          <div class="flex h-14 items-center text-foreground">
            <Wordmark class="h-9 w-auto" />
          </div>
          <p class="mt-4 text-sm font-semibold text-foreground">Eczar SemiBold</p>
          <p class="text-sm">The wordmark and the homepage headline.</p>
        </div>
        <div class="rounded-[18px] bg-paper p-5">
          <p class="flex h-14 items-center text-3xl font-semibold text-foreground">Pot-au-feu</p>
          <p class="mt-4 text-sm font-semibold text-foreground">Inter</p>
          <p class="text-sm">Everything else.</p>
        </div>
        <div class="rounded-[18px] bg-paper p-5">
          <p class="flex h-14 items-center font-handwritten text-5xl leading-none text-foreground">
            À table !
          </p>
          <p class="mt-4 text-sm font-semibold text-foreground">Reenie Beanie</p>
          <p class="text-sm">One handwritten sign-off per page, at most.</p>
        </div>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="depth">
      <h2 id="depth" class="text-2xl font-medium text-foreground">Shape and depth</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed">
        Controls are capsules and cards have 18 px corners. Everything is flat, except photos,
        which sit in a white frame with a soft shadow.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div
          class="flex h-44 flex-col justify-between rounded-[18px] bg-background p-4 ring-1 ring-hairline ring-inset"
        >
          <span />
          <span>
            <span class="block text-sm font-semibold text-foreground">Page</span>
            <span class="block text-xs">Grey, no shadow.</span>
          </span>
        </div>
        <div class="flex h-44 flex-col justify-between rounded-[18px] bg-paper p-4">
          <span
            class="inline-flex h-9 items-center self-start rounded-full bg-fill px-4 text-sm text-foreground"
          >
            Search
          </span>
          <span>
            <span class="block text-sm font-semibold text-foreground">Card</span>
            <span class="block text-xs">White on the page, fields filled.</span>
          </span>
        </div>
        <div class="flex h-44 flex-col justify-between rounded-[18px] bg-paper p-4">
          <span class="flex flex-wrap gap-2">
            <span
              class="inline-flex h-8 items-center rounded-full bg-accent px-4 text-[13px] font-semibold text-white"
            >
              Save
            </span>
            <span
              class="inline-flex h-8 items-center rounded-full bg-fill px-4 text-[13px] font-semibold text-foreground"
            >
              Cancel
            </span>
          </span>
          <span>
            <span class="block text-sm font-semibold text-foreground">Buttons</span>
            <span class="block text-xs">Flat capsules.</span>
          </span>
        </div>
        <div class="flex h-44 flex-col justify-between rounded-[18px] bg-paper p-4">
          <span
            class="size-12 rounded-[23%] bg-paper p-0.5 shadow-[0_0_1px_rgb(0_0_0/0.16),0_1px_2px_rgb(0_0_0/0.08),0_10px_24px_rgb(0_0_0/0.12)]"
          >
            <span class="block size-full rounded-[22%] bg-placeholder" />
          </span>
          <span>
            <span class="block text-sm font-semibold text-foreground">Photo</span>
            <span class="block text-xs">The only thing that floats.</span>
          </span>
        </div>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="voice">
      <h2 id="voice" class="text-2xl font-medium text-foreground">Writing</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed">
        Plain and friendly. When something breaks, say what happened and how to fix it.
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <div class="rounded-[18px] bg-paper p-5 ring-1 ring-hairline ring-inset">
          <p class="text-xs font-semibold text-accent">Yes</p>
          <p class="mt-1 text-foreground">Couldn't reach Lardon. Check your connection.</p>
        </div>
        <div class="rounded-[18px] bg-paper p-5 ring-1 ring-hairline ring-inset">
          <p class="text-xs font-semibold text-danger">No</p>
          <p class="mt-1 text-foreground">Error 503: network request failed.</p>
        </div>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="misuse">
      <h2 id="misuse" class="text-2xl font-medium text-foreground">Please don't</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          [
            ["Stretch it", "text-foreground", "scale-x-150"],
            ["Recolor it", "text-danger", ""],
            ["Add effects", "text-accent", "drop-shadow-[0_0_10px_rgb(122_140_48/0.9)]"],
          ].map(([caption, color, effect]) => (
            <figure>
              <div
                class:list={[
                  "flex h-32 items-center justify-center overflow-hidden rounded-[18px] bg-paper ring-1 ring-hairline ring-inset",
                  color,
                ]}
              >
                <Logo class:list={["h-7 w-auto", effect]} />
              </div>
              <figcaption class="mt-2 flex items-center gap-2 text-sm text-foreground">
                <span aria-hidden="true" class="text-danger">✕</span>
                {caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="mt-20" aria-labelledby="files">
      <h2 id="files" class="text-2xl font-medium text-foreground">Files</h2>
      <ul class="mt-6 divide-y divide-hairline border-y border-hairline">
        {
          [
            [
              "Logo",
              [
                ["Ink", "/brand/lardon-logo-ink.svg"],
                ["White", "/brand/lardon-logo-white.svg"],
                ["Olive", "/brand/lardon-logo-olive.svg"],
              ],
            ],
            [
              "Stacked logo",
              [
                ["Ink", "/brand/lardon-logo-stacked-ink.svg"],
                ["White", "/brand/lardon-logo-stacked-white.svg"],
              ],
            ],
            [
              "Bacon strip",
              [
                ["Ink", "/brand/lardon-mark-ink.svg"],
                ["White", "/brand/lardon-mark-white.svg"],
                ["Olive", "/brand/lardon-mark-olive.svg"],
              ],
            ],
            [
              "Wordmark",
              [
                ["Ink", "/brand/lardon-wordmark-ink.svg"],
                ["White", "/brand/lardon-wordmark-white.svg"],
              ],
            ],
            [
              "App icon",
              [
                ["Square PNG", "/brand/lardon-app-icon.png"],
                ["Rounded SVG", "/brand/lardon-app-icon-rounded.svg"],
              ],
            ],
          ].map(([name, files]) => (
            <li class="grid grid-cols-[8rem_1fr] items-center gap-4 py-2">
              <span class="text-sm text-foreground">{name}</span>
              <span class="flex flex-wrap gap-x-4">
                {(files as string[][]).map(([label, href]) => (
                  <a
                    href={href}
                    download
                    class="-m-2 inline-flex min-h-11 items-center rounded-sm p-2 text-sm text-muted underline underline-offset-2 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    {label}
                  </a>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <SiteFooter class="max-w-5xl" />
</Base>
