---
import { appDownloadUrl } from "../app-download";
import borscht from "@lardon/brand/assets/photos/borscht.jpg";
import lasagna from "@lardon/brand/assets/photos/lasagna.jpg";
import pancakes from "@lardon/brand/assets/photos/pancakes.jpg";
import PhotoSticker from "../components/photo-sticker.astro";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import Base from "../layouts/base.astro";
---

<Base
  title="Lardon"
  description="A cookbook your family shares. Write down the dishes you grew up with, and everyone has them on their phone."
>
  <main class="overflow-x-clip">
    <section class="overflow-hidden bg-accent text-white">
      <SiteHeader class="max-w-5xl" surface="accent" />
      <div class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-8 text-center sm:pt-12">
        <h1 class="font-wordmark text-5xl leading-[1.15] text-balance sm:text-7xl">
          Grandma's quiche,<br class="max-sm:hidden" /> on everyone's phone.
        </h1>
        <p class="mt-6 max-w-md text-[17px] leading-relaxed text-white/80">
          Lardon is a cookbook your family shares. Write a recipe down once and the whole family
          has it the next time they cook.
        </p>
        <a
          href={appDownloadUrl}
          class="mt-8 inline-flex h-12 items-center rounded-full bg-white px-6 text-[17px] font-semibold text-accent hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/60"
        >
          Start your cookbook
        </a>
      </div>
      <div
        class="mt-10 flex w-full min-w-0 items-start justify-center pb-12 sm:mt-12 sm:pb-16"
      >
        <PhotoSticker
          src={pancakes}
          widthPx={208}
          class="mt-8 -mr-4 w-28 -rotate-7 motion-safe:animate-float sm:mt-10 sm:-mr-5 sm:w-52"
        />
        <PhotoSticker
          src={lasagna}
          widthPx={288}
          class="z-10 w-40 rotate-2 motion-safe:animate-float motion-safe:[animation-duration:4.2s] sm:w-72"
        />
        <PhotoSticker
          src={borscht}
          widthPx={208}
          class="mt-8 -ml-4 w-28 rotate-6 motion-safe:animate-float motion-safe:[animation-delay:-2s] motion-safe:[animation-duration:5.6s] sm:mt-10 sm:-ml-5 sm:w-52"
        />
      </div>
    </section>

    <section
      id="get-the-app"
      class="bg-paper px-6 py-20 text-center sm:py-28"
    >
      <h2 class="font-handwritten text-7xl leading-none text-accent sm:text-9xl">À table !</h2>
      <p class="mt-3 text-[17px]">
        Lardon is coming soon to iPhone and Android.
      </p>
    </section>
  </main>
  <SiteFooter class="max-w-5xl" />
</Base>
