---
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  class: string;
}

const { src, class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "aspect-square shrink-0 rounded-[23%] bg-paper p-0.5 shadow-[0_0_1px_rgb(0_0_0/0.16),0_1px_2px_rgb(0_0_0/0.08),0_10px_24px_rgb(0_0_0/0.12)]",
    className,
  ]}
>
  <img
    src={src.src}
    alt=""
    width={src.width}
    height={src.height}
    decoding="async"
    class="size-full rounded-[22%] object-cover"
  />
</div>
