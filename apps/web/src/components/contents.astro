---
interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---

<nav aria-label="Contents">
  <ol class="gap-x-8 *:my-0! *:py-0.5 sm:columns-2">
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`}>{section.title}</a>
        </li>
      ))
    }
  </ol>
</nav>
