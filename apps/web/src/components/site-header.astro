---
import { appDownloadUrl } from "../app-download";
import Logo from "@lardon/brand/assets/logo.svg";

interface Props {
  class: string;
  surface: "accent" | "plain";
}

const { class: className, surface } = Astro.props;
---

<header
  class:list={[
    "mx-auto flex w-full items-center justify-between px-6 pt-6",
    surface === "accent" ? "text-white" : "text-foreground",
    className,
  ]}
>
  <a
    href="/"
    class="-m-2 inline-flex min-h-11 items-center rounded-full p-2 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
  >
    <Logo class="h-6 w-auto" />
  </a>
  <a
    href={appDownloadUrl}
    class:list={[
      "inline-flex h-10 items-center rounded-full px-4 text-[15px] font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current",
      surface === "accent"
        ? "bg-white text-accent hover:bg-white/90"
        : "bg-accent text-white hover:bg-accent-deep",
    ]}
  >
    Get the app
  </a>
</header>
