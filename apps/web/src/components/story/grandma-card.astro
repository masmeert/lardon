---
interface Props {
  title: string;
  ingredients: string[];
  position: number;
}

const { title, ingredients, position } = Astro.props;
---

<div
  data-position={position}
  class="rounded-sm border border-[#e3d4ae] bg-[#f8eed6] px-4 pt-2 pb-4 shadow-[0_1px_2px_rgb(34_28_24/0.08),0_10px_20px_rgb(34_28_24/0.06)] [grid-area:1/1] motion-safe:transition-[translate,rotate] motion-safe:duration-300 data-[position=0]:z-30 data-[position=0]:rotate-1 group-hover:data-[position=0]:-translate-y-1.5 data-[position=1]:z-20 data-[position=1]:-translate-x-2 data-[position=1]:-translate-y-1 data-[position=1]:-rotate-3 data-[position=2]:z-10 data-[position=2]:translate-x-3 data-[position=2]:-translate-y-2 data-[position=2]:rotate-6 data-leaving:translate-x-[115%]! data-leaving:rotate-12!"
>
  <p class="font-cursive text-[26px] leading-10 text-[#2f4b86]">{title}</p>
  {
    ingredients.map((ingredient) => (
      <div class="flex h-7 items-end border-b border-[#d9c79c]">
        <span class="font-cursive text-[17px] leading-7 text-[#2f4b86]/80">{ingredient}</span>
      </div>
    ))
  }
</div>
