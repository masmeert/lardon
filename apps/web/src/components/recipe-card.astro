---
interface Props {
  emoji: string;
  title: string;
  ingredients: string[];
  ruledLineCount: number;
  isFeatured: boolean;
  class: string;
}

const { emoji, title, ingredients, ruledLineCount, isFeatured, class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "relative shrink-0 overflow-hidden rounded-md border-[0.5px] border-hairline bg-card py-3 pr-3 pl-9 shadow-[0_1px_2px_rgb(34_28_24/0.06),0_14px_28px_rgb(34_28_24/0.07)]",
    className,
  ]}
>
  <div class="absolute inset-y-0 left-7 w-px bg-card-margin"></div>
  <p
    class:list={[
      "truncate pr-1.5 font-handwritten text-foreground",
      isFeatured ? "text-[44px] leading-11" : "text-[34px] leading-9",
    ]}
  >
    {title}
  </p>
  <div class="mt-1">
    {
      Array.from({ length: ruledLineCount }, (_, index) => (
        <div
          class:list={[
            "-mr-3 -ml-9 flex items-end border-b border-card-rule pr-3 pl-9",
            isFeatured ? "h-9" : "h-7",
          ]}
        >
          <span
            class:list={[
              "truncate font-handwritten text-foreground/70",
              isFeatured ? "text-[32px] leading-9" : "text-[26px] leading-7",
            ]}
          >
            {ingredients[index] ?? ""}
          </span>
        </div>
      ))
    }
  </div>
  <span class:list={["absolute right-3 bottom-2", isFeatured ? "text-4xl" : "text-3xl"]}>
    {emoji}
  </span>
</div>
