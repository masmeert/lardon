---
import Logo from "@lardon/brand/assets/logo.svg";
import { operator, studioUrl } from "@lardon/brand";

interface Props {
  class: string;
}

const { class: className } = Astro.props;
---

<footer class="overflow-hidden bg-background text-[13px] text-muted">
  <div class:list={["mx-auto w-full px-6 pt-8 pb-12", className]}>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {new Date().getFullYear()}{" "}
      <a
        href={studioUrl}
        class="hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {operator.tradeName}
      </a>
    </p>
    <nav aria-label="Footer" class="-mx-2 flex flex-wrap">
      {
        [
          ["Contact", `mailto:${operator.contactEmail}`],
          ["Brand", "/brand"],
          ["Privacy Policy", "/privacy"],
          ["Terms of Use", "/terms"],
        ].map(([label, href]) => (
          <a
            href={href}
            class="inline-flex min-h-11 items-center rounded-full px-2 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {label}
          </a>
        ))
      }
    </nav>
    </div>
    <div class="mt-6 border-t border-hairline pt-10">
      <Logo aria-hidden="true" class="h-auto w-full text-fill" />
    </div>
  </div>
</footer>
