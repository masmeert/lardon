---
import { operator } from "../operator";

interface Props {
  class: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["mx-auto w-full px-6 pb-24", className]}>
  <div class="border-t border-line pt-6">
    <nav aria-label="Legal" class="flex flex-wrap gap-x-4 gap-y-1">
      <a
        href="/terms"
        class="-m-2 inline-flex min-h-11 items-center rounded-sm p-2 text-muted-soft underline underline-offset-2 hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
      >
        Terms of Use
      </a>
      <a
        href="/privacy"
        class="-m-2 inline-flex min-h-11 items-center rounded-sm p-2 text-muted-soft underline underline-offset-2 hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
      >
        Privacy Policy
      </a>
    </nav>
    <address class="mt-4 flex flex-wrap gap-x-3 text-xs leading-5 text-muted-soft not-italic">
      <span>{operator.name}</span>
      <span>{operator.address}, {operator.country}</span>
      <span>Enterprise and VAT number {operator.enterpriseNumber}</span>
      <a
        href={`mailto:${operator.contactEmail}`}
        class="underline underline-offset-2 hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
      >
        {operator.contactEmail}
      </a>
    </address>
  </div>
</footer>
