---
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import Base from "./base.astro";

interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<Base title={title} description={description}>
  <div class="bg-linear-to-b from-accent-light to-accent text-card">
    <SiteHeader class="max-w-5xl" />
    <div class="mx-auto max-w-5xl px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
      <h1 class="text-5xl leading-[1.05] font-medium tracking-tight sm:text-7xl">{title}</h1>
      {lastUpdated && <p class="mt-5 text-base text-card/70">Last updated {lastUpdated}</p>}
    </div>
  </div>
  <div
    class="mx-auto grid max-w-5xl gap-10 px-6 pt-12 pb-24 lg:grid-cols-[13rem_1fr] lg:gap-16 lg:pt-16"
  >
    <aside class="lg:sticky lg:top-8 lg:self-start">
      <slot name="aside" />
    </aside>
    <main
      class="prose prose-lardon max-w-2xl prose-headings:scroll-mt-8 prose-headings:font-medium prose-headings:tracking-tight prose-h2:mt-14 prose-h2:mb-4 prose-h2:text-2xl prose-h3:mt-8 prose-h3:mb-2 prose-h3:text-lg prose-h3:text-ink prose-p:leading-relaxed prose-a:font-normal prose-a:underline-offset-2 prose-a:hover:text-muted prose-a:focus-visible:outline-2 prose-a:focus-visible:outline-offset-4 prose-a:focus-visible:outline-line-strong prose-strong:font-medium prose-li:my-1 prose-th:font-medium prose-th:text-ink-strong"
    >
      <slot />
    </main>
  </div>
  <SiteFooter class="max-w-5xl" />
</Base>
