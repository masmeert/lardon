---
import { Font } from "astro:assets";

import Logo from "../assets/logo.svg";
import { operator } from "../operator";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title === "Lardon" ? title : `${title} · Lardon`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-hanken-grotesk" preload />
  </head>
  <body
    class="bg-paper font-sans text-sm leading-relaxed text-muted antialiased selection:bg-accent-soft selection:text-ink"
  >
    <div class="mx-auto w-full max-w-lg px-6 pt-16 pb-24">
      <header class="mb-8">
        <a
          href="/"
          class="-m-2 inline-flex min-h-11 items-center rounded-sm p-2 text-ink-strong hover:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
        >
          <Logo class="h-6 w-auto" />
        </a>
      </header>
      <main
        class="prose prose-sm prose-lardon max-w-none prose-headings:font-medium prose-h1:mb-1 prose-h1:text-sm prose-h1:leading-5 prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-sm prose-h2:leading-5 prose-h3:mt-6 prose-h3:mb-1 prose-h3:text-sm prose-h3:text-ink prose-p:leading-relaxed prose-a:font-normal prose-a:underline-offset-2 prose-a:hover:text-muted prose-a:focus-visible:outline-2 prose-a:focus-visible:outline-offset-4 prose-a:focus-visible:outline-line-strong prose-strong:font-medium prose-li:my-1 prose-th:font-medium prose-th:text-ink-strong"
      >
        <slot />
      </main>
      <footer class="mt-16 border-t border-line pt-6">
        <nav aria-label="Legal" class="flex flex-wrap gap-x-4 gap-y-1">
          <a
            href="/terms"
            class="-m-2 inline-flex min-h-11 items-center rounded-sm p-2 text-muted-soft underline underline-offset-2 hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
          >
            Terms of Use
          </a>
          <a
            href="/privacy"
            class="-m-2 inline-flex min-h-11 items-center rounded-sm p-2 text-muted-soft underline underline-offset-2 hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
          >
            Privacy Policy
          </a>
        </nav>
        <address
          class="mt-4 flex flex-wrap gap-x-3 text-xs leading-5 text-muted-soft not-italic"
        >
          <span>{operator.name}</span>
          <span>{operator.address}, {operator.country}</span>
          <span>Enterprise and VAT number {operator.enterpriseNumber}</span>
          <a
            href={`mailto:${operator.contactEmail}`}
            class="underline underline-offset-2 hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-strong"
          >
            {operator.contactEmail}
          </a>
        </address>
      </footer>
    </div>
  </body>
</html>
