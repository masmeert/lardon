# @public @type=enum(development, production, test)
NODE_ENV=development

# Which API the app talks to: `development` is the local dev server (simulator), `production` the
# deployed worker. Run device and release builds with APP_ENV=production.
# @sensitive=false @type=enum(development, production)
APP_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=remap($APP_ENV, development, "http://localhost:3000", production, "https://lardon-server-prod-k6treqbxdozih53s.masmeert.workers.dev")
