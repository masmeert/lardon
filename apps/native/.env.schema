# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Which API the app talks to: `development` is the local dev server (simulator), `production` the
# deployed worker. Run device and release builds with APP_ENV=production.
# @sensitive=false @type=enum(development, production)
APP_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=remap($APP_ENV, development, "http://localhost:3000", production, "https://api.lardon.app")

# The website with the terms and privacy policy the app links to.
# @public @type=url
EXPO_PUBLIC_WEBSITE_URL="https://lardon.app"

# Where the app's "Contact support" row sends emails.
# @public @type=email
EXPO_PUBLIC_SUPPORT_EMAIL="support@lardon.app"
