{
  "name": "lardon",
  "private": true,
  "license": "PolyForm-Strict-1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "dev:native": "vp run --filter native dev",
    "db:generate": "vp run --filter @lardon/db db:generate",
    "deploy": "vp run --filter @lardon/infra deploy",
    "destroy": "vp run --filter @lardon/infra destroy",
    "env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@lardon/config": "workspace:*",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "rolldown": "1.2.15",
    "typescript": "^6.0.3",
    "varlock": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
