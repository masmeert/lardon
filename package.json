{
  "name": "lardon",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "test": "vp run -r test",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:native": "vp run --filter native dev",
    "db:generate": "vp run --filter @lardon/db db:generate",
    "deploy": "vp run --filter @lardon/infra deploy",
    "destroy": "vp run --filter @lardon/infra destroy",
    "env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@lardon/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "rolldown": "1.2.15",
    "typescript": "^6.0.3",
    "varlock": "catalog:",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.15.0"
}
